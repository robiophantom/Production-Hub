# Company A Production Hub — environment template
#
# Copy to `.env.local` for local development and uncomment only what you need.
# The app runs with zero configuration on the embedded PGlite database.
# NEVER commit `.env`, `.env.local`, service-role keys or real credentials.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public origin used for share links and redirects. Must be an absolute URL.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# IANA timezone used to decide the business date for production updates.
# BUSINESS_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave unset to use the embedded PostgreSQL (PGlite) at .data/pgdata.
# Hosted Postgres/Supabase: use the pooler connection string in server env only.
# The pooler URL contains credentials, so never expose it with NEXT_PUBLIC_.
# DATABASE_URL=postgresql://postgres.<project>:<password>@<host>:6543/postgres?pgbouncer=true

# Demo accounts with documented passwords are seeded only into the embedded
# database. This flag is ignored for any DATABASE_URL connection.
# SEED_DEMO_DATA=true

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Local sign-in signs an HS256 JWT in the ca_session cookie. Set a long random
# value in every deployed environment (32+ characters recommended).
# AUTH_SECRET=replace-with-a-long-random-string

# Supabase Auth (optional). When the public URL and publishable key are present,
# sign-in first validates against Supabase Auth, then links to public.profiles.
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy alias accepted by the code: NEXT_PUBLIC_SUPABASE_ANON_KEY

# Server-only service-role secret. Required for `npm run admin:bootstrap` when
# Supabase Auth is configured. NEVER prefix this with NEXT_PUBLIC_ and never
# import it into a client component.
# SUPABASE_SECRET_KEY=
# Legacy alias accepted by the code: SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Image and voice storage (optional)
# ---------------------------------------------------------------------------
# Without Cloudinary, uploads are written to .data/uploads and served through
# /api/files/<filename>. Cloudinary takes over automatically when all three
# values are set.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Image upload limit in megabytes (voice notes have a fixed 12 MB limit).
# MAX_UPLOAD_MB=8

# ---------------------------------------------------------------------------
# AI assistance (optional, server-side only)
# ---------------------------------------------------------------------------
# Tamil issue classification and voice transcription use Google's Gemini API.
# Without a key the app falls back to a deterministic keyword classifier
# and manual transcription; production updates are never blocked.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash
# AI_CLASSIFICATION_ENABLED=true
# AI_VOICE_ENABLED=true
